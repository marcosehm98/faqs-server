{
  "name": "faq-server",
  "version": "1.0.0",
  "description": "Servidor FAQ con panel de administración separado",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:win": "node scripts/build-windows.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
